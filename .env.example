PORT=8787
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Required for real generation
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.5-flash,gemini-1.5-flash-latest
GEMINI_BATCH_SIZE=20
GEMINI_BATCH_CONCURRENCY=2
GEMINI_BATCH_TIMEOUT_MS=35000
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=60000
GROQ_MAX_RATE_WAIT_MS=8000

# Question refresh agent / Vercel cron / GitHub Actions
QUESTION_AGENT_SECRET=choose_a_long_private_secret
CRON_SECRET=choose_the_same_or_another_long_private_secret
QUESTION_AGENT_API_URL=http://localhost:3001/api/agent/refresh
QUESTION_AGENT_INTERVAL_MINUTES=60
QUESTION_AGENT_ENABLE_WEB_SEARCH=1

# Firebase Admin. Use either GOOGLE_APPLICATION_CREDENTIALS or the inline fields below.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CACHE_COLLECTION=questionCache

# Optional client override for deployed API URL
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:8787

# Supabase comments and admin OTP
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
SUPABASE_COMMENTS_TABLE=comments
SUPABASE_QUESTION_CACHE_TABLE=question_cache
ADMIN_PHONE=9835379900
ADMIN_OTP_CODE=choose_a_private_admin_code_if_supabase_sms_is_not_enabled
